<Window x:Class="Task1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task1"
        mc:Ignorable="d"
        Title="Registration" Height="620" Width="400">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Login" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/>
            
           <TextBox x:Name="LoginTextBox" Margin="0,10,0,0" Height="30" Text="Enter your login"/>
            <TextBlock Text="Password" Margin="0,10,0,0" FontSize="16"/>
            <PasswordBox x:Name="PasswordBox" Height="30"/>
            <TextBlock Text="Confirm Password" Margin="0,10,0,0" FontSize="16"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="30"/>
            <CheckBox x:Name="AcceptTermsCheckBox" Margin="0,10,0,0" Content="I accept the terms and conditions"/>
            <Button Content="Register" Margin="0,20,0,0" Height="30" Width="150" VerticalAlignment="Center" HorizontalAlignment="Center" Click="RegisterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
