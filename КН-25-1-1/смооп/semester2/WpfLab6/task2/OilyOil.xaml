<Window x:Class="WpfLab6.task2.OilyOil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BestOil" Height="400" Width="550" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Автозаправка" Grid.Column="0" Margin="5">
            <StackPanel Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Пальне:" />
                    <ComboBox x:Name="cmbFuel" Grid.Column="1" SelectionChanged="CmbFuel_SelectionChanged"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Ціна:" />
                    <TextBox x:Name="txtFuelPrice" Grid.Column="1" IsReadOnly="True" Background="#EEE"/>
                    <Label Content="грн" Grid.Column="2"/>
                </Grid>

                <GroupBox Margin="0,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="rbLiters" Content="Кількість" IsChecked="True" Checked="RbFuelMode_Checked" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtLiters" Grid.Column="1" Margin="5,2" TextChanged="CalculateFuel"/>
                        <Label Content="л." Grid.Column="2"/>

                        <RadioButton x:Name="rbMoney" Content="Сума" Grid.Row="1" Checked="RbFuelMode_Checked" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtMoney" Grid.Row="1" Grid.Column="1" Margin="5,2" IsEnabled="False" TextChanged="CalculateFuel"/>
                        <Label Content="грн" Grid.Row="1" Grid.Column="2"/>
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="gbFuelResult" Header="До оплати:">
                    <TextBlock x:Name="tbFuelResult" Text="0.00" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                </GroupBox>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Міні-кафе" Grid.Column="1" Margin="5">
            <StackPanel Margin="5">
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="chkHotDog" Content="Хот-дог" VerticalAlignment="Center" Click="CafeItem_Click"/>
                    <TextBox x:Name="txtHotDogPrc" Grid.Column="1" Text="40,00" IsReadOnly="True" Background="#EEE" Margin="2"/>
                    <TextBox x:Name="txtHotDogCnt" Grid.Column="2" IsEnabled="False" TextChanged="CalculateCafe" Margin="2"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="chkBurger" Content="Гамбургер" VerticalAlignment="Center" Click="CafeItem_Click"/>
                    <TextBox x:Name="txtBurgerPrc" Grid.Column="1" Text="55,00" IsReadOnly="True" Background="#EEE" Margin="2"/>
                    <TextBox x:Name="txtBurgerCnt" Grid.Column="2" IsEnabled="False" TextChanged="CalculateCafe" Margin="2"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="chkCola" Content="Кока-кола" VerticalAlignment="Center" Click="CafeItem_Click"/>
                    <TextBox x:Name="txtColaPrc" Grid.Column="1" Text="25,00" IsReadOnly="True" Background="#EEE" Margin="2"/>
                    <TextBox x:Name="txtColaCnt" Grid.Column="2" IsEnabled="False" TextChanged="CalculateCafe" Margin="2"/>
                </Grid>

                <GroupBox Header="До оплати:" Margin="0,15,0,0">
                    <TextBlock x:Name="tbCafeResult" Text="0.00" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                </GroupBox>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Content="Підрахувати" Width="120" Height="40" Click="BtnCalculateTotal_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Label Content="Загальна сума:" FontSize="16"/>
                    <TextBlock x:Name="tbTotal" Text="0.00" FontSize="28" FontWeight="Bold" Margin="10,0" Foreground="Blue"/>
                    <Label Content="грн" FontSize="16"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>