<Window x:Class="WpfLab6.task1.Calculator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator" Height="500" Width="320" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F3F3F3" FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="NumBtn" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="Button" x:Key="EqBtn" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="prevText" Grid.Row="0" Grid.ColumnSpan="4" TextAlignment="Right" BorderThickness="0" Background="Transparent" Foreground="#5C5C5C" FontSize="14" IsReadOnly="True"/>
        <TextBox x:Name="curText" Grid.Row="1" Grid.ColumnSpan="4" TextAlignment="Right" BorderThickness="0" Background="Transparent" FontSize="48" FontWeight="SemiBold" Text="0" Margin="0,0,0,16" IsReadOnly="True"/>

        <Button Content="&#xE94F;" Tag="&lt;" Grid.Row="2" Grid.Column="0" FontFamily="Segoe Fluent Icons" Click="BtnBackspace_Click"/>
        <Button Content="CE" Grid.Row="2" Grid.Column="1" Click="BtnCE_Click"/>
        <Button Content="C" Grid.Row="2" Grid.Column="2" Click="BtnC_Click"/>
        <Button Content="&#xE94A;" Tag="/" Grid.Row="2" Grid.Column="3" FontFamily="Segoe Fluent Icons" FontSize="16" Click="BtnOperation_Click"/>

        <Button Content="7" Grid.Row="3" Grid.Column="0" Style="{StaticResource NumBtn}" Click="BtnNumber_Click"/>
        <Button Content="8" Grid.Row="3" Grid.Column="1" Style="{StaticResource NumBtn}" Click="BtnNumber_Click"/>
        <Button Content="9" Grid.Row="3" Grid.Column="2" Style="{StaticResource NumBtn}" Click="BtnNumber_Click"/>
        <Button Content="&#xE947;" Tag="*" Grid.Row="3" Grid.Column="3" FontFamily="Segoe Fluent Icons" FontSize="16" Click="BtnOperation_Click"/>

        <Button Content="4" Grid.Row="4" Grid.Column="0" Style="{StaticResource NumBtn}" Click="BtnNumber_Click"/>
        <Button Content="5" Grid.Row="4" Grid.Column="1" Style="{StaticResource NumBtn}" Click="BtnNumber_Click"/>
        <Button Content="6" Grid.Row="4" Grid.Column="2" Style="{StaticResource NumBtn}" Click="BtnNumber_Click"/>
        <Button Content="&#xE949;" Tag="-" Grid.Row="4" Grid.Column="3" FontFamily="Segoe Fluent Icons" FontSize="16" Click="BtnOperation_Click"/>

        <Button Content="1" Grid.Row="5" Grid.Column="0" Style="{StaticResource NumBtn}" Click="BtnNumber_Click"/>
        <Button Content="2" Grid.Row="5" Grid.Column="1" Style="{StaticResource NumBtn}" Click="BtnNumber_Click"/>
        <Button Content="3" Grid.Row="5" Grid.Column="2" Style="{StaticResource NumBtn}" Click="BtnNumber_Click"/>
        <Button Content="&#xE948;" Tag="+" Grid.Row="5" Grid.Column="3" FontFamily="Segoe Fluent Icons" FontSize="16" Click="BtnOperation_Click"/>

        <Button Content="0" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource NumBtn}" Click="BtnNumber_Click"/>
        <Button Content="," Grid.Row="6" Grid.Column="2" Click="BtnDot_Click"/>
        <Button Content="=" Grid.Row="6" Grid.Column="3" Style="{StaticResource EqBtn}" Click="BtnEqual_Click"/>
    </Grid>
</Window>