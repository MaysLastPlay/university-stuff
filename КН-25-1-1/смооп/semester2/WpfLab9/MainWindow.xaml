<Window x:Class="WpfLab9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfLab9.classes"
        xmlns:services="clr-namespace:WpfLab9.classes.services"
        Title="Студенти (MVVM)" Height="420" Width="680" MinWidth="560" MinHeight="340">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <services:AgeConverter x:Key="AgeConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <!-- Student List -->
        <ListBox x:Name="StudentsList"
                 Grid.Column="0"
                 ItemsSource="{Binding Students}"
                 SelectedItem="{Binding SelectedStudent}"
                 SelectionMode="Extended"
                 AlternationCount="2"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Style.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA" Padding="20">
                                            <TextBlock Text="У списку немає елементів. Додайте нового студента."
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Foreground="Gray"
                                                       FontSize="14" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#EEF4FB" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding Gender}" Foreground="Gray" FontSize="12" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Age, Converter={StaticResource AgeConverter}}"
                                   VerticalAlignment="Center"
                                   FontSize="13" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Прізвище:" Margin="0,0,0,4" />
            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="4" />

            <TextBlock Text="Ім'я:" Margin="0,0,0,4" />
            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="4" />

            <TextBlock Text="Вік (16–100):" Margin="0,0,0,4" />
            <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="4" />

            <TextBlock Text="Стать:" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Genders}"
                      SelectedItem="{Binding Gender}"
                      Margin="0,0,0,16"
                      Padding="4" />

            <Button Content="Додати"
                    Command="{Binding AddCommand}"
                    Margin="0,0,0,8" Padding="6" />

            <Button Content="Зберегти зміни"
                    Command="{Binding EditCommand}"
                    Margin="0,0,0,8" Padding="6" />

            <Button Content="Видалити вибраних"
                    Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=StudentsList}"
                    Padding="6" />
        </StackPanel>
    </Grid>
</Window>