<Window x:Class="WpfLab5.Task1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfLab5"
        mc:Ignorable="d"
        Title="Task1" Height="450" Width="800">
    <Grid>
        <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="Exit to Main Menu" Click="BtnMainMenu_Click" Width="200" Height="35" Padding="10" Margin="10"/>
            <StackPanel Margin="20" VerticalAlignment="Center">
               <TextBlock x:Name="Task1Text" Text="Job Start" FontSize="18" HorizontalAlignment="Center"/>
                <Button Content="Hello" Click="BtnHello_Click" Width="150" Height="30" Padding="5"/>
                <Button Content="Goodbye" Click="BtnGoodbye_Click" Width="150" Height="30" Padding="5"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
