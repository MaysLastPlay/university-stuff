<Window x:Class="WpfLab5.Task4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfLab5"
        mc:Ignorable="d"
        Title="Task4" Height="450" Width="800">

    <DockPanel>
        <Button DockPanel.Dock="Bottom" Content="Вийти до головного меню" Click="BtnMainMenu_Click" Width="200" Height="35" Margin="10"/>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="Btn1" Grid.Row="0" Grid.Column="1" Margin="10" Content="Перша" Background="Crimson" Foreground="White" FontSize="18" FontWeight="Bold" Click="Btn_Click"/>

            <Button x:Name="Btn2" Grid.Row="1" Grid.Column="0" Margin="10" Content="Друга" Background="Gold" Foreground="Black" FontSize="16" FontStyle="Italic" Click="Btn_Click"/>

            <Button x:Name="Btn3" Grid.Row="1" Grid.Column="1" Margin="10" Content="Третя" Background="DodgerBlue" Foreground="White" FontSize="22" FontFamily="Consolas" Click="Btn_Click"/>

            <Button x:Name="Btn4" Grid.Row="1" Grid.Column="2" Margin="10" Content="Четверта" Background="LimeGreen" Foreground="DarkRed" FontSize="14" FontWeight="Black" Click="Btn_Click"/>

            <Button x:Name="Btn5" Grid.Row="2" Grid.Column="1" Margin="10" Content="П'ята" Background="Purple" Foreground="Yellow" FontSize="20" FontFamily="Comic Sans MS" Click="Btn_Click"/>
        </Grid>
    </DockPanel>
</Window>
