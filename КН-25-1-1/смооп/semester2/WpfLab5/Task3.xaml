<Window x:Class="WpfLab5.Task3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfLab5"
        mc:Ignorable="d"
        Title="Task3" Height="450" Width="800">
    <Grid>
        <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="Exit to Main Menu" Click="BtnMainMenu_Click" Width="200" Height="35" Margin="10"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBox x:Name="Task3Input" Width="200" Height="30" FontSize="14" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                <Button Content="Hide" Click="BtnHideInput_Click" Width="150" Height="30" Margin="0,0,0,10"/>
                <Button Content="Show" Click="BtnShowInput_Click" Width="150" Height="30" Margin="0,0,0,10"/>
                <Button Content="Clear" Click="BtnClearInput_Click" Width="150" Height="30"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
