<Window x:Class="WpfLab5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfLab5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <StackPanel Margin="20">
            <TextBlock x:Name="MMText" Text="Choose Task" FontSize="18" HorizontalAlignment="Center"/>

            <Button Content="Task 1" Click="BtnTask1_Click" Padding="5"/>
            <Button Content="Task 2" Click="BtnTask2_Click" Padding="5"/>
            <Button Content="Task 3" Click="BtnTask3_Click" Padding="5"/>
            <Button Content="Task 4" Click="BtnTask4_Click" Padding="5"/>
            <Button Content="Task 5" Click="BtnTask5_Click" Padding="5"/>
            <Button Content="Task 6" Click="BtnTask6_Click" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>
