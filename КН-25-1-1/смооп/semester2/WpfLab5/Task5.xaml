<Window x:Class="WpfLab5.Task5"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfLab5"
        mc:Ignorable="d"
        Title="Task5" Height="450" Width="800">
    <Grid>
        <DockPanel>
        <Button DockPanel.Dock="Bottom" Content="Exit to Main Menu" Click="BtnMainMenu_Click" Width="200" Height="35" Margin="10"/>

        <Canvas x:Name="MouseMoused" Background="WhiteSmoke" Margin="10">

            <Button x:Name="CatchButton" Content="Press Me" Width="100" Height="40" Background="LightCoral" FontWeight="Bold" MouseEnter="CatchButton_MouseEnter" Click="CatchButton_Click" Canvas.Left="200" Canvas.Top="120"/>

        </Canvas>
    </DockPanel>
    </Grid>
</Window>
