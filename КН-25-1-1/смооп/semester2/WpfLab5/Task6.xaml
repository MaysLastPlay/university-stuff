<Window x:Class="WpfLab5.Task6"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfLab5"
        mc:Ignorable="d"
        Title="Task6" Height="450" Width="800">
    <Grid>
        <DockPanel>
            <Button DockPanel.Dock="Bottom" 
                Content="Exit to Main Menu" 
                Click="BtnMainMenu_Click" 
                Width="200" Height="35" Margin="10"/>

            <StackPanel Margin="20" VerticalAlignment="Center">

                <TextBlock x:Name="RecipeText" Text="Recipe: R: ?, G: ?, B: ?" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Rectangle x:Name="MagicCrystal" Width="150" Height="100" Stroke="Black" StrokeThickness="1" HorizontalAlignment="Center" RadiusX="10" RadiusY="10"/>

                    <TextBlock Text="Red (R):"/>
                    <Slider x:Name="SliderR" Minimum="0" Maximum="255" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

                    <TextBlock Text="Green (G):"/>
                    <Slider x:Name="SliderG" Minimum="0" Maximum="255" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

                    <TextBlock Text="Blue (B):"/>
                <Slider x:Name="SliderB" Minimum="0" Maximum="255" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
