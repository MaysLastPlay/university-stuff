<Window x:Class="WpfLab7.windows.TwitterLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X (formerly Twitter)" SizeToContent="Height" Width="350"
        Background="Black" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow">
    <StackPanel Margin="20">
        <TextBlock Text="𝕏" Foreground="White" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-10,0,5"/>
        <TextBlock Text="Ласкаво просимо в безодню" FontSize="20" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15"/>
        <TextBlock Text="Доведіть, що ви не бот (хоча ми не впевнені). Готові втратити кілька нервових клітин в онлайн-суперечках?" 
                   TextWrapping="Wrap" TextAlignment="Center" Foreground="#71767B" Margin="0,0,0,20"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Скасувати" Background="Transparent" Foreground="White" BorderBrush="#333639" BorderThickness="1" Padding="5,10" Margin="5" Click="BtnCancel_Click"/>
            <Button Grid.Column="1" Content="Почати дискусію" Background="White" Foreground="Black" FontWeight="Bold" BorderThickness="0" Padding="5,10" Margin="5" Click="BtnAccept_Click"/>
        </Grid>
    </StackPanel>
</Window>