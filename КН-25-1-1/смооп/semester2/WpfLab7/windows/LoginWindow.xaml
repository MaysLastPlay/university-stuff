<Window x:Class="WpfLab7.windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхід" Height="620" Width="400"
        Background="#F3F3F3" FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentColor" Color="#005FB8"/>
        <SolidColorBrush x:Key="AccentColorHover" Color="#0053A0"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#FDFDFD"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#606060"/>

        <Style TargetType="Control" x:Key="InputStyle">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                    <Setter Property="BorderThickness" Value="1,1,1,2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource InputStyle}"/>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource InputStyle}"/>

        <Style TargetType="CheckBox" x:Key="CheckBoxStyle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,5,0,25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button" x:Key="AccentButton">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColorHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="TextButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" 
                                   Foreground="{TemplateBinding Foreground}" 
                                   TextDecorations="None" 
                                   HorizontalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentColorHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SocialButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8F8F8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Background="White" CornerRadius="8" Margin="30" Padding="30"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="15" ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="З поверненням!" FontSize="24" FontWeight="SemiBold" 
                           Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                <TextBlock Text="Увійдіть до свого акаунту" FontSize="12" 
                           Foreground="{StaticResource SecondaryText}" Margin="0,0,0,25"/>

                <TextBlock Text="Електронна пошта" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail" Margin="0,0,0,15"/>

                <TextBlock Text="Пароль" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="pwdBox" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <CheckBox x:Name="chkRememberMe" Content="Запам'ятати мене" Style="{StaticResource CheckBoxStyle}" HorizontalAlignment="Left" Margin="0"/>
                    <Button Content="Забули пароль?" Click="BtnForgotPassword_Click" Style="{StaticResource TextButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Button x:Name="btnLogin" Content="Увійти" 
                        Style="{StaticResource AccentButton}" Click="BtnLogin_Click" Margin="0,15,0,20"/>

                <Grid Margin="0,5,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Separator Grid.Column="0" VerticalAlignment="Center" Background="{StaticResource BorderColor}"/>
                    <TextBlock Grid.Column="1" Text="Або увійдіть через" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="10,0"/>
                    <Separator Grid.Column="2" VerticalAlignment="Center" Background="{StaticResource BorderColor}"/>
                </Grid>

                <UniformGrid Columns="3" Margin="-5,0,-5,20">
                    <Button Style="{StaticResource SocialButton}" Click="BtnGoogle_Click">
                        <StackPanel Orientation="Horizontal" Margin="5,0">
                            <Path Data="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" 
                                  Fill="#DB4437" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Google" Foreground="#DB4437" Margin="6,0,0,1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SocialButton}" Click="BtnDiscord_Click">
                        <StackPanel Orientation="Horizontal" Margin="5,0">
                            <Path Data="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09c-.01-.02-.04-.03-.07-.03c-1.5.26-2.93.71-4.27 1.33c-.01 0-.02.01-.03.02C2.71 9.98 1.5 14.65 1.8 19.32c0 .02.01.03.02.04c1.78 1.32 3.51 2.1 5.2 2.65c.03.01.06 0 .07-.02c.4-.55.76-1.13 1.07-1.74c.02-.04 0-.08-.04-.09c-.57-.22-1.11-.48-1.64-.78c-.04-.02-.04-.08-.01-.11c.11-.08.22-.17.33-.25c.02-.02.05-.02.07-.01c3.44 1.57 7.15 1.57 10.55 0c.02-.01.05-.01.07.01c.11.09.22.17.33.26c.04.03.04.09 0 .11c-.52.31-1.07.56-1.64.78c-.04.01-.05.06-.04.09c.32.61.68 1.19 1.07 1.74c.01.02.04.03.07.02c1.7-0.55 3.42-1.33 5.2-2.65c.01-.01.02-.02.02-.04c.36-5.34-1.2-10.02-3.13-13.97c-.01-.01-.02-.02-.03-.02zM8.5 14.83c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.84 2.12-1.89 2.12zm7 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.84 2.12-1.89 2.12z" 
                                  Fill="#5865F2" Width="16" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Discord" Foreground="#5865F2" Margin="6,0,0,1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SocialButton}" Click="BtnTwitter_Click">
                        <StackPanel Orientation="Horizontal" Margin="5,0">
                            <Path Data="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" 
                                  Fill="#0F1419" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Twitter" Foreground="#0F1419" Margin="6,0,0,1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Немає акаунту? " Foreground="{StaticResource SecondaryText}" FontSize="13"/>
                    <Button Content="Зареєструватися" Style="{StaticResource TextButton}" Click="BtnGoToRegister_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>