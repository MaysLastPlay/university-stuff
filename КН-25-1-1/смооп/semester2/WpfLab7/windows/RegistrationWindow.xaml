<Window x:Class="WpfLab7.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація" Height="680" Width="420"
        Background="#F3F3F3" FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentColor" Color="#005FB8"/>
        <SolidColorBrush x:Key="AccentColorHover" Color="#0053A0"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#FDFDFD"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#606060"/>

        <Style TargetType="Control" x:Key="InputStyle">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                    <Setter Property="BorderThickness" Value="1,1,1,2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource InputStyle}"/>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource InputStyle}"/>

        <Style TargetType="RadioButton" x:Key="RadioButtonStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>

        <Style TargetType="CheckBox" x:Key="CheckBoxStyle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,15,0,25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button" x:Key="AccentButton">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColorHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Background="White" CornerRadius="8" Margin="30" Padding="30"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="15" ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Створення акаунту" FontSize="24" FontWeight="SemiBold" 
                           Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                <TextBlock Text="Заповніть дані для продовження" FontSize="12" 
                           Foreground="{StaticResource SecondaryText}" Margin="0,0,0,25"/>

                <TextBlock Text="Повне ім'я" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                <TextBox x:Name="txtName" Margin="0,0,0,15"/>

                <TextBlock Text="Електронна пошта" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail" Margin="0,0,0,15"/>

                <TextBlock Text="Дата народження" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                <DatePicker x:Name="dpBirthDate" Margin="0,0,0,15" Height="38"/>

                <TextBlock Text="Стать" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <RadioButton x:Name="rbMale" Content="Чоловіча" Style="{StaticResource RadioButtonStyle}" IsChecked="True"/>
                    <RadioButton x:Name="rbFemale" Content="Жіноча" Style="{StaticResource RadioButtonStyle}"/>
                    <RadioButton x:Name="rbOther" Content="Інше" Style="{StaticResource RadioButtonStyle}"/>
                </StackPanel>

                <TextBlock Text="Пароль" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="pwdBox" Margin="0,0,0,10"/>
                <TextBlock Text="Мінімум 8 символів" FontSize="11" Foreground="{StaticResource SecondaryText}"/>

                <CheckBox x:Name="chkAgree" Content="Я погоджуюсь з умовами використання" Style="{StaticResource CheckBoxStyle}"/>

                <Button x:Name="btnRegister" Content="Зареєструватися" 
                        Style="{StaticResource AccentButton}" Click="BtnRegister_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>